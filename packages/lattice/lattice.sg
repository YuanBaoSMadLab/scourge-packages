# ============================================================================
#  封装层（薄壳，非平行实现：只组合上方导出）
# ============================================================================

# 编译期锁定 torch 版本（如 "2.13.0"）——运行期 torch.dll 版本必须一致
def PIN() -> str:
    return version()

# 版本守卫第三层（前两层：编译期宏、DLL 内冒烟）：init 冒烟 + pin 逐字比对。
# 醒目打印锁定版本——新版 torch 拉取后 ABI 失配在这里"挨骂"而不是静默出错。
def init_guard(expected: str) -> int:
    clear_err()
    if init() != 1:
        print("[lattice] init FAIL:", last_err())
        return 0
    got: str = version()
    print("[lattice] shim OK | torch pin", got, "| expect", expected)
    if got != expected:
        print("[lattice] VERSION MISMATCH - 重编 shim(shim/build_shim.bat) 或改 pin")
        return 0
    return 1
