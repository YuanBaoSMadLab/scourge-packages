# ============================================================================
#  lattice - PyTorch (LibTorch) FFI 桥（纯 C++，无 Python 依赖）
# ----------------------------------------------------------------------------
#  绑定契约单一事实源在 packages/lattice/shim/lattice_shim.hpp（句柄/shape/
#  dtype/错误态协议均以该头为准）。本文件只做声明转发 + 最小封装：
#  Scourge 侧惯用短名（zeros/randn/matmul...）经 symbol= 别名到 C 符号
#  lattice_*。双模约束：VM 与 AOT 均为运行期动态解析，无需链接期配置；
#  运行需保证 lattice.dll 与 torch 的 lib 目录在 PATH（torch pin 版本必须
#  与编译期一致，错配由 init() 版本守卫拦截）。
#  capability：ffi（仅此一项；包内无其他能力面）。
# ============================================================================
capability ffi

# ---- core：生命周期与版本（9） ---------------------------------------------

@extern("lattice.dll", symbol="lattice_version")
def version() -> str:
    pass
@extern("lattice.dll", symbol="lattice_version_int")
def version_int() -> int:
    pass
@extern("lattice.dll", symbol="lattice_init")
def init() -> int:
    pass
@extern("lattice.dll", symbol="lattice_last_err")
def last_err() -> str:
    pass
@extern("lattice.dll", symbol="lattice_clear_err")
def clear_err() -> None:
    pass
@extern("lattice.dll", symbol="lattice_free")
def free(h: int) -> int:
    pass
@extern("lattice.dll", symbol="lattice_handle_alive")
def handle_alive(h: int) -> int:
    pass
@extern("lattice.dll", symbol="lattice_free_all")
def free_all() -> int:
    pass
@extern("lattice.dll", symbol="lattice_build_info")
def build_info() -> str:
    pass

